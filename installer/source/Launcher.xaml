<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Midnight Club L.A. Recompiled" Width="1240" Height="860" MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="#0A0C10" Foreground="#F1F5F9" FontFamily="Segoe UI" TextElement.FontFamily="Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style TargetType="Control"><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <SolidColorBrush x:Key="Accent" Color="#FF453A"/>
  <SolidColorBrush x:Key="AccentAmber" Color="#FBBF24"/>
  <Style TargetType="ScrollBar">
   <Setter Property="Background" Value="#0A0C10"/>
   <Setter Property="Width" Value="9"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ScrollBar">
      <Track x:Name="PART_Track" IsDirectionReversed="True">
       <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton>
       <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#2B3344" CornerRadius="4" Margin="2,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
       <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton>
      </Track>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#1B212D"/>
   <Setter Property="Foreground" Value="#E2E8F0"/>
   <Setter Property="BorderBrush" Value="#2E3748"/>
   <Setter Property="Padding" Value="15,10"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter TextElement.FontFamily="Segoe UI" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#252D3E"/><Setter TargetName="B" Property="BorderBrush" Value="#435068"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.88"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.38"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Foreground" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#FF5A52"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Background">
    <Setter.Value>
     <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#E5322E" Offset="0"/>
      <GradientStop Color="#C41E1A" Offset="1"/>
     </LinearGradientBrush>
    </Setter.Value>
   </Setter>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <Border.Effect><DropShadowEffect Color="#E5322E" BlurRadius="14" ShadowDepth="0" Opacity="0.28"/></Border.Effect>
       <ContentPresenter TextElement.FontFamily="Segoe UI" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="B" Property="BorderBrush" Value="#FF7A73"/>
        <Setter TargetName="B" Property="Background">
         <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
           <GradientStop Color="#FF453A" Offset="0"/>
           <GradientStop Color="#D92622" Offset="1"/>
          </LinearGradientBrush>
         </Setter.Value>
        </Setter>
       </Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.9"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.38"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="AmberButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#2A1D0B"/>
   <Setter Property="Foreground" Value="#FBBF24"/>
   <Setter Property="BorderBrush" Value="#7A5316"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter TextElement.FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#3B290F"/><Setter TargetName="B" Property="BorderBrush" Value="#F59E0B"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.38"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="ChromeButton" TargetType="Button">
   <Setter Property="Width" Value="40"/>
   <Setter Property="Height" Value="32"/>
   <Setter Property="Foreground" Value="#94A3B8"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="5">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#1E2534"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="5">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#E5322E"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="LinkButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#94A3B8"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" TextDecorations="Underline"/>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Foreground" Value="#FF6B66"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#0D1017"/>
   <Setter Property="Foreground" Value="#F1F5F9"/>
   <Setter Property="BorderBrush" Value="#2C3444"/>
   <Setter Property="Padding" Value="11,8"/>
   <Setter Property="CaretBrush" Value="#FF453A"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TextBox">
      <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
       <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#E5322E"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#F1F5F9"/>
   <Setter Property="Background" Value="#171C26"/>
   <Setter Property="Padding" Value="12,9"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
       <ContentPresenter TextElement.FontFamily="Segoe UI"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#2E1A1F"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#3A1D21"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#F1F5F9"/>
   <Setter Property="Background" Value="#0E121A"/>
   <Setter Property="Padding" Value="12,8"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid>
       <ToggleButton Foreground="#F1F5F9" Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="B" Background="#0E121A" BorderBrush="#2C3444" BorderThickness="1" CornerRadius="7">
           <Grid>
            <ContentPresenter TextElement.FontFamily="Segoe UI" Margin="12,8,30,8" Content="{Binding SelectionBoxItem,RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
            <TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#FF453A" FontWeight="Bold"/>
           </Grid>
          </Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#46536C"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
       <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
        <Border Background="#171C26" BorderBrush="#333C4F" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}">
         <ScrollViewer MaxHeight="340"><ItemsPresenter/></ScrollViewer>
        </Border>
       </Popup>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#F1F5F9"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="CheckBox">
      <StackPanel Orientation="Horizontal">
       <Border x:Name="Track" Width="44" Height="24" CornerRadius="12" Background="#2B3342" BorderBrush="#394357" BorderThickness="1">
        <Border x:Name="Thumb" Width="16" Height="16" Margin="3" CornerRadius="8" Background="#CBD5E1" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
         <Border.RenderTransform><ScaleTransform x:Name="ThumbScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
        </Border>
       </Border>
       <ContentPresenter TextElement.FontFamily="Segoe UI" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Track" Property="Background" Value="#E5322E"/>
        <Setter TargetName="Track" Property="BorderBrush" Value="#FF6B66"/>
        <Setter TargetName="Thumb" Property="Background" Value="#FFFFFF"/>
        <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
        <Trigger.EnterActions>
         <BeginStoryboard>
          <Storyboard>
           <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" From="0.8" To="1" Duration="0:0:0.15"/>
           <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" From="0.8" To="1" Duration="0:0:0.15"/>
          </Storyboard>
         </BeginStoryboard>
        </Trigger.EnterActions>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="Nav" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#94A3B8"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Margin" Value="0,2"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="RadioButton">
      <Border x:Name="BG" CornerRadius="0,8,8,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="14,12">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" FontSize="15" Foreground="#64748B" VerticalAlignment="Center"/>
        <ContentPresenter TextElement.FontFamily="Segoe UI" Grid.Column="1" VerticalAlignment="Center"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="BG" Property="Background">
         <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
           <GradientStop Color="#33E5322E" Offset="0"/>
           <GradientStop Color="#08E5322E" Offset="1"/>
          </LinearGradientBrush>
         </Setter.Value>
        </Setter>
        <Setter TargetName="BG" Property="BorderBrush" Value="#E5322E"/>
        <Setter TargetName="Icon" Property="Foreground" Value="#FF453A"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
       </Trigger>
       <MultiTrigger>
        <MultiTrigger.Conditions>
         <Condition Property="IsMouseOver" Value="True"/>
         <Condition Property="IsChecked" Value="False"/>
        </MultiTrigger.Conditions>
        <Setter TargetName="BG" Property="Background" Value="#171D28"/>
        <Setter Property="Foreground" Value="#E2E8F0"/>
       </MultiTrigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="#151922"/>
   <Setter Property="BorderBrush" Value="#252B38"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="12"/>
   <Setter Property="Padding" Value="20"/>
  </Style>
  <Style x:Key="SoftCard" TargetType="Border">
   <Setter Property="Background" Value="#11151D"/>
   <Setter Property="BorderBrush" Value="#212735"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="10"/>
   <Setter Property="Padding" Value="15"/>
  </Style>
  <Style x:Key="Heading" TargetType="TextBlock">
   <Setter Property="FontSize" Value="26"/>
   <Setter Property="FontWeight" Value="ExtraBold"/>
   <Setter Property="Foreground" Value="#FFFFFF"/>
   <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#94A3B8"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="LineHeight" Value="20"/>
  </Style>
 </Window.Resources>

 <Border x:Name="RootFrame" BorderBrush="#252B38" BorderThickness="1" Background="#0A0C10">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="42"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>

   <!-- Barra de título escura integrada -->
   <Border Grid.Row="0" Background="#0D1016" BorderBrush="#1E2432" BorderThickness="0,0,0,1" Padding="14,0">
    <Grid>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Image x:Name="TitleIcon" Width="18" Height="18" Margin="0,0,10,0"/>
      <TextBlock Text="Midnight Club L.A. Recompiled" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
      <Border Background="#1B212E" BorderBrush="#2F384C" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,8,0" VerticalAlignment="Center">
       <TextBlock x:Name="TitleVersion" Text="v1.0.0" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"/>
      </Border>
      <Border x:Name="TitleStatusBadge" Background="#162921" BorderBrush="#2B6B4D" BorderThickness="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
       <TextBlock x:Name="TitleStatusText" Text="Prepare seu jogo" FontSize="10" FontWeight="SemiBold" Foreground="#6EE7B7"/>
      </Border>
     </StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Button x:Name="MinimizeButton" Content="─" Style="{StaticResource ChromeButton}" FontSize="11"/>
      <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource ChromeButton}" FontSize="12"/>
      <Button x:Name="CloseButton" Content="✕" Style="{StaticResource ChromeCloseButton}" FontSize="11"/>
     </StackPanel>
    </Grid>
   </Border>

   <!-- Conteúdo principal -->
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="236"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Barra Lateral -->
    <Border Grid.Column="0" BorderBrush="#1F2533" BorderThickness="0,0,1,0">
     <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
       <GradientStop Color="#101319" Offset="0"/>
       <GradientStop Color="#0B0E14" Offset="1"/>
      </LinearGradientBrush>
     </Border.Background>
     <DockPanel Margin="14,18,14,16">
      <StackPanel DockPanel.Dock="Top" Margin="6,0,6,18">
       <Image x:Name="SideLogo" Height="64" Stretch="Uniform"/>
       <Grid Margin="2,10,2,0">
        <TextBlock Text="EDITION PT-BR" Foreground="#FBBF24" FontSize="10" FontWeight="Bold"/>
        <TextBlock x:Name="SidebarVersion" Text="v1.0.0" HorizontalAlignment="Right" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"/>
       </Grid>
       <Border Height="1" Background="#1F2533" Margin="0,14,0,0"/>
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Margin="4,12,4,0">
       <Border Height="1" Background="#1F2533" Margin="0,0,0,12"/>
       <Button x:Name="CheckUpdatesButton" Content="↻  Verificar atualizações" Padding="10,8" FontSize="12" Margin="0,0,0,10"/>
       <Grid Margin="2,0">
        <TextBlock Text="GitHub oficial:" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
        <Button x:Name="GithubLinkButton" Content="shad0w77-code" Style="{StaticResource LinkButton}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
       </Grid>
      </StackPanel>

      <StackPanel x:Name="Navigation">
       <RadioButton x:Name="NavHome" Content="Início" Tag="▶" Style="{StaticResource Nav}" GroupName="Nav" IsChecked="True"/>
       <RadioButton x:Name="NavGraphics" Content="Gráficos" Tag="◈" Style="{StaticResource Nav}" GroupName="Nav"/>
       <RadioButton x:Name="NavControls" Content="Controles" Tag="◎" Style="{StaticResource Nav}" GroupName="Nav"/>
       <RadioButton x:Name="NavRadio" Content="Rádio e Mundo" Tag="♫" Style="{StaticResource Nav}" GroupName="Nav"/>
       <RadioButton x:Name="NavSaves" Content="Saves e Mods" Tag="▣" Style="{StaticResource Nav}" GroupName="Nav"/>
       <RadioButton x:Name="NavLogs" Content="Registro" Tag="≡" Style="{StaticResource Nav}" GroupName="Nav"/>
       <RadioButton x:Name="NavCredits" Content="Créditos" Tag="◇" Style="{StaticResource Nav}" GroupName="Nav"/>
      </StackPanel>
     </DockPanel>
    </Border>

    <!-- Área de Páginas + Rodapé -->
    <Grid Grid.Column="1">
     <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="46"/>
     </Grid.RowDefinitions>

     <Grid Grid.Row="0" Margin="28,22,28,16">

      <!-- ==================== INÍCIO ==================== -->
      <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto">
       <ScrollViewer.RenderTransform><TranslateTransform x:Name="PageHomeTransform" Y="0"/></ScrollViewer.RenderTransform>
       <StackPanel>

        <!-- Banner de atualização remota (GitHub Releases) -->
        <Border x:Name="RemoteUpdateBanner" Visibility="Collapsed" BorderBrush="#9C6514" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,18">
         <Border.RenderTransform><TranslateTransform x:Name="BannerTransform" Y="0"/></Border.RenderTransform>
         <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
           <GradientStop Color="#27190C" Offset="0"/>
           <GradientStop Color="#1B1514" Offset="0.6"/>
           <GradientStop Color="#151922" Offset="1"/>
          </LinearGradientBrush>
         </Border.Background>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
           <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            <Border Background="#3D290D" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,10,0">
             <TextBlock Text="ATUALIZAÇÃO NO GITHUB" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"/>
            </Border>
            <TextBlock x:Name="RemoteUpdateTitle" Text="Nova versão disponível" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
           </StackPanel>
           <TextBlock x:Name="RemoteUpdateSummary" Text="Seus saves e configurações serão mantidos." Style="{StaticResource Hint}" FontSize="12" Foreground="#CBD5E1"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
           <Button x:Name="DownloadUpdateButton" Content="Baixar e atualizar" Style="{StaticResource Primary}" Padding="16,10" FontSize="12" Margin="0,0,10,0"/>
           <Button x:Name="OpenReleaseButton" Content="Ver no GitHub" Padding="14,10" FontSize="12"/>
          </StackPanel>
         </Grid>
        </Border>

        <!-- Hero + Painel de Ação -->
        <Grid Margin="0,0,0,18">
         <Grid.ColumnDefinitions><ColumnDefinition Width="1.68*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border CornerRadius="14" ClipToBounds="True" BorderBrush="#2A3142" BorderThickness="1" Background="#141821" Margin="0,0,16,0" Height="254">
          <Grid>
           <Image x:Name="HeroArt" Stretch="UniformToFill" Opacity="0.84"/>
           <Rectangle>
            <Rectangle.Fill>
             <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#180A0C10" Offset="0"/>
              <GradientStop Color="#B80A0C10" Offset="0.65"/>
              <GradientStop Color="#FA0A0C10" Offset="1"/>
             </LinearGradientBrush>
            </Rectangle.Fill>
           </Rectangle>
           <Rectangle>
            <Rectangle.Fill>
             <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#C80A0C10" Offset="0"/>
              <GradientStop Color="#000A0C10" Offset="0.7"/>
             </LinearGradientBrush>
            </Rectangle.Fill>
           </Rectangle>
           <StackPanel VerticalAlignment="Bottom" Margin="22">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
             <Ellipse Width="7" Height="7" Fill="#E5322E" Margin="0,0,8,0" VerticalAlignment="Center"/>
             <TextBlock Text="XBOX 360 STATIC RECOMPILATION" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"/>
            </StackPanel>
            <TextBlock Text="LOS ANGELES." FontSize="32" FontWeight="Black" Foreground="#FFFFFF" LineHeight="32"/>
            <TextBlock Text="DO SEU JEITO." FontSize="26" FontWeight="Black" Foreground="#FF453A" LineHeight="28"/>
            <WrapPanel x:Name="HeroChips" Margin="0,10,0,0"/>
           </StackPanel>
          </Grid>
         </Border>

         <Border Grid.Column="1" Style="{StaticResource Card}">
          <Grid>
           <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <StackPanel>
            <TextBlock Text="PRONTO PARA A RUA?" FontWeight="Bold" Foreground="#94A5B8" FontSize="11"/>
            <TextBlock x:Name="InstallStatus" Text="Prepare seu jogo" FontSize="23" FontWeight="ExtraBold" Foreground="#FFFFFF" Margin="0,8,0,6" TextWrapping="Wrap"/>
            <TextBlock x:Name="HomeActionHint" Text="Sua ISO será necessária apenas na preparação." Style="{StaticResource Hint}" FontSize="12"/>
           </StackPanel>
           <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <Button x:Name="PlayButton" Content="▶  JOGAR" Style="{StaticResource Primary}" FontSize="18" Padding="16,12" IsEnabled="False"/>
            <Grid Margin="0,10,0,0">
             <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
             <Button x:Name="PrepareShadersButton" Content="Preparar shaders" FontSize="12" Padding="10,9"/>
             <Button x:Name="LocateButton" Grid.Column="2" Content="Localizar pasta" FontSize="12" Padding="10,9"/>
            </Grid>
           </StackPanel>
          </Grid>
         </Border>
        </Grid>

        <!-- Resumo quando instalado -->
        <Grid x:Name="ReadySummaryGrid" Visibility="Collapsed" Margin="0,0,0,16">
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Border Grid.Column="0" Style="{StaticResource SoftCard}">
          <StackPanel>
           <TextBlock Text="PASTA ATIVA" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
           <TextBlock x:Name="SummaryPath" Text="-" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,6,0,3"/>
           <TextBlock x:Name="SummaryPathDetail" Text="Tradução PT-BR ativa" FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
          </StackPanel>
         </Border>
         <Border Grid.Column="2" Style="{StaticResource SoftCard}">
          <StackPanel>
           <TextBlock Text="PROTEÇÃO DE SAVES" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
           <TextBlock x:Name="SummarySaveStatus" Text="Backup automático ativo" FontSize="13" FontWeight="Bold" Foreground="#6EE7B7" Margin="0,6,0,3"/>
           <TextBlock Text="10 cópias recentes em save-backups ao clicar em Jogar" FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
          </StackPanel>
         </Border>
         <Border Grid.Column="4" Style="{StaticResource SoftCard}">
          <StackPanel>
           <TextBlock Text="SHADER PACK" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
           <TextBlock x:Name="SummaryShaderStatus" Text="545407F8.shaderpack" FontSize="13" FontWeight="Bold" Foreground="#FBBF24" Margin="0,6,0,3"/>
           <TextBlock Text="Importação automática na inicialização do jogo" FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
          </StackPanel>
         </Border>
        </Grid>

        <!-- Acordeão para gerenciar/reinstalar quando já pronto -->
        <Button x:Name="ReinstallToggle" Visibility="Collapsed" HorizontalContentAlignment="Stretch" Padding="18,13" Margin="0,0,0,10">
         <Grid>
          <StackPanel>
           <TextBlock Text="GERENCIAR INSTALAÇÃO / REINSTALAR COM ISO" FontSize="12" FontWeight="Bold" Foreground="#E2E8F0"/>
           <TextBlock Text="Expanda caso queira preparar outra pasta ou alternar o idioma PT-BR / Inglês" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
          </StackPanel>
          <TextBlock x:Name="ReinstallChevron" Text="▼ Mostrar" FontSize="11" FontWeight="SemiBold" Foreground="#FBBF24" HorizontalAlignment="Right" VerticalAlignment="Center"/>
         </Grid>
        </Button>

        <!-- Painel de Preparação / Atualização -->
        <Border x:Name="SetupPanel" Style="{StaticResource Card}">
         <StackPanel>
          <TextBlock x:Name="IsoLabel" Text="Arquivo ISO (Xbox 360 Complete Edition)" FontWeight="SemiBold" FontSize="13"/>
          <Grid x:Name="IsoRow" Margin="0,8,0,16">
           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
           <TextBox x:Name="IsoPath" Margin="0,0,12,0"/>
           <Button x:Name="BrowseIso" Content="Procurar ISO…" Grid.Column="1"/>
          </Grid>
          <TextBlock Text="Pasta do jogo" FontWeight="SemiBold" FontSize="13"/>
          <Grid Margin="0,8,0,6">
           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
           <TextBox x:Name="InstallPath" Margin="0,0,12,0"/>
           <Button x:Name="BrowseInstall" Content="Escolher pasta…" Grid.Column="1"/>
          </Grid>
          <TextBlock Text="Escolha uma subpasta. Você pode editar o caminho e o nome; não use a própria pasta do instalador." Style="{StaticResource Hint}" FontSize="11"/>
          <Border x:Name="TranslateCard" Background="#121721" BorderBrush="#392427" BorderThickness="1" CornerRadius="9" Padding="15,13" Margin="0,16,0,0">
           <StackPanel>
            <CheckBox x:Name="TranslateGame" Content="Traduzir o jogo para português (PT-BR)" IsChecked="True" FontWeight="SemiBold"/>
            <TextBlock Text="Recomendado. Aplica tradução de menus, telefone, missões, garagem e legendas com fontes corrigidas (Õ/õ). Desmarque para manter em inglês." Style="{StaticResource Hint}" FontSize="11" Margin="56,5,0,0"/>
           </StackPanel>
          </Border>
          <CheckBox x:Name="DesktopShortcut" Content="Criar atalho na Área de Trabalho para jogar diretamente" IsChecked="True" Margin="0,15,0,16"/>
          <WrapPanel>
           <Button x:Name="PrepareButton" Content="PREPARAR MEU JOGO" Style="{StaticResource Primary}" Margin="0,0,12,0"/>
           <Button x:Name="OpenGameFolder" Content="Abrir pasta"/>
          </WrapPanel>
         </StackPanel>
        </Border>

        <Border Background="#11151D" BorderBrush="#212735" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,14,0,0">
         <TextBlock x:Name="HomeInfo" Text="Use sua própria ISO de Midnight Club: Los Angeles Complete Edition para Xbox 360." Style="{StaticResource Hint}" FontSize="12"/>
        </Border>
       </StackPanel>
      </ScrollViewer>

      <!-- ==================== GRÁFICOS ==================== -->
      <Grid x:Name="PageGraphics" Visibility="Collapsed">
       <Grid.RenderTransform><TranslateTransform x:Name="PageGraphicsTransform" Y="0"/></Grid.RenderTransform>
       <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
         <TextBlock Text="GRÁFICOS" Style="{StaticResource Heading}"/>
         <TextBlock Text="Escolha um perfil rápido ou ajuste cada opção. As mudanças valem na próxima abertura do jogo." Style="{StaticResource Hint}" Margin="0,0,0,18"/>
         <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Button x:Name="PresetLight" Grid.Column="0" HorizontalContentAlignment="Left" Padding="16,14">
           <StackPanel>
            <TextBlock Text="MAIS DESEMPENHO" FontWeight="Bold" Foreground="#FBBF24" FontSize="12"/>
            <TextBlock Text="720p base, menos sombras e detalhe reduzido. FSR em Qualidade." Foreground="#94A3B8" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"/>
           </StackPanel>
          </Button>
          <Button x:Name="PresetBalanced" Grid.Column="2" HorizontalContentAlignment="Left" Padding="16,14">
           <StackPanel>
            <TextBlock Text="EQUILIBRADO" FontWeight="Bold" Foreground="#FBBF24" FontSize="12"/>
            <TextBlock Text="720p base, detalhes em 75%. FSR em Qualidade." Foreground="#94A3B8" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"/>
           </StackPanel>
          </Button>
          <Button x:Name="PresetNative" Grid.Column="4" HorizontalContentAlignment="Left" Padding="16,14">
           <StackPanel>
            <TextBlock Text="NATIVE AA" FontWeight="Bold" Foreground="#FF453A" FontSize="12"/>
            <TextBlock Text="720p base sem redução pelo FSR e detalhes completos." Foreground="#94A3B8" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"/>
           </StackPanel>
          </Button>
         </Grid>
         <TextBlock x:Name="PresetLabel" Text="Perfil: Equilibrado" Foreground="#FBBF24" FontWeight="SemiBold" Margin="0,0,0,14"/>
         <StackPanel x:Name="GraphicsGroups"/>
        </StackPanel>
       </ScrollViewer>
       <Button x:Name="ApplyGraphics" Grid.Row="1" Content="SALVAR CONFIGURAÇÕES" Style="{StaticResource Primary}" HorizontalAlignment="Right" Margin="0,14,0,0"/>
      </Grid>

      <!-- ==================== CONTROLES ==================== -->
      <Grid x:Name="PageControls" Visibility="Collapsed">
       <Grid.RenderTransform><TranslateTransform x:Name="PageControlsTransform" Y="0"/></Grid.RenderTransform>
       <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
         <TextBlock Text="PERFIL E CONTROLES" Style="{StaticResource Heading}"/>
         <TextBlock Text="Identidade do save, ícones de botões, teclado/mouse, vibração e dead zones." Style="{StaticResource Hint}" Margin="0,0,0,18"/>
         <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
           <StackPanel Grid.Column="0">
            <TextBlock Text="NOME DO JOGADOR" FontWeight="Bold" Foreground="#FF453A" FontSize="12" Margin="0,0,0,10"/>
            <TextBox x:Name="PlayerName" Text="User" MaxLength="15"/>
            <TextBlock Text="Até 15 caracteres ASCII (sem acento). Trocar o nome cria/seleciona outra pasta de save sem apagar a anterior." Style="{StaticResource Hint}" FontSize="11" Margin="0,8,0,0"/>
           </StackPanel>
           <StackPanel Grid.Column="2">
            <TextBlock Text="ÍCONES DOS BOTÕES" FontWeight="Bold" Foreground="#FF453A" FontSize="12" Margin="0,0,0,10"/>
            <ComboBox x:Name="ButtonPrompts">
             <ComboBoxItem Content="Xbox" Tag="xbox"/>
             <ComboBoxItem Content="PlayStation" Tag="playstation"/>
             <ComboBoxItem Content="Automático" Tag="auto"/>
            </ComboBox>
            <TextBlock Text="Xbox é o padrão. Também pode ser alterado dentro do jogo." Style="{StaticResource Hint}" FontSize="11" Margin="0,8,0,0"/>
           </StackPanel>
          </Grid>
         </Border>
         <StackPanel x:Name="ControlsGroups"/>
        </StackPanel>
       </ScrollViewer>
       <Button x:Name="ApplyProfile" Grid.Row="1" Content="SALVAR PERFIL E CONTROLES" Style="{StaticResource Primary}" HorizontalAlignment="Right" Margin="0,14,0,0"/>
      </Grid>

      <!-- ==================== RÁDIO E MUNDO ==================== -->
      <Grid x:Name="PageRadio" Visibility="Collapsed">
       <Grid.RenderTransform><TranslateTransform x:Name="PageRadioTransform" Y="0"/></Grid.RenderTransform>
       <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
         <TextBlock Text="RÁDIO MP3 E MUNDO" Style="{StaticResource Heading}"/>
         <TextBlock Text="Músicas MP3 próprias integradas às estações do jogo, unidades em km/h, relógio real, clima e câmera livre." Style="{StaticResource Hint}" Margin="0,0,0,18"/>
         <StackPanel x:Name="RadioWorldGroups"/>
        </StackPanel>
       </ScrollViewer>
       <Button x:Name="ApplyRadioWorld" Grid.Row="1" Content="SALVAR RÁDIO E MUNDO" Style="{StaticResource Primary}" HorizontalAlignment="Right" Margin="0,14,0,0"/>
      </Grid>

      <!-- ==================== SAVES E MODS ==================== -->
      <ScrollViewer x:Name="PageSaves" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
       <ScrollViewer.RenderTransform><TranslateTransform x:Name="PageSavesTransform" Y="0"/></ScrollViewer.RenderTransform>
       <StackPanel>
        <TextBlock Text="SAVES, BACKUPS E MODS" Style="{StaticResource Heading}"/>
        <TextBlock Text="Proteja seu progresso com backups ZIP validados e jogue com mods sem arriscar sua campanha principal." Style="{StaticResource Hint}" Margin="0,0,0,18"/>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
         <StackPanel>
          <TextBlock Text="BACKUPS E RESTAURAÇÃO SEGURA" FontWeight="Bold" Foreground="#FF453A" FontSize="12"/>
          <Border Background="#10141C" BorderBrush="#222938" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,8">
           <StackPanel>
            <TextBlock x:Name="SavePath" Text="Prepare ou localize uma instalação." TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="#FFFFFF"/>
            <TextBlock x:Name="SaveSummary" Style="{StaticResource Hint}" FontSize="11" Margin="0,4,0,0"/>
           </StackPanel>
          </Border>
          <WrapPanel Margin="0,8,0,0">
           <Button x:Name="BackupSaves" Content="Exportar backup .zip" Style="{StaticResource Primary}" Margin="0,0,10,8"/>
           <Button x:Name="RestoreSaves" Content="Restaurar ZIP" Margin="0,0,10,8"/>
           <Button x:Name="RecoverAutoBackup" Content="Recuperar backup automático" Margin="0,0,10,8"/>
          </WrapPanel>
          <WrapPanel Margin="0,4,0,0">
           <Button x:Name="OpenSaves" Content="Abrir pasta dos dados" Padding="12,8" FontSize="12" Margin="0,0,10,0"/>
           <Button x:Name="OpenAutoBackups" Content="Abrir backups automáticos" Padding="12,8" FontSize="12" Margin="0,0,10,0"/>
           <Button x:Name="OpenScreenshots" Content="Abrir capturas (F12)" Padding="12,8" FontSize="12"/>
          </WrapPanel>
          <TextBlock Text="Ao iniciar pelo botão JOGAR, o configurador cria um ZIP automático em save-backups e mantém as 10 cópias mais recentes. A restauração valida caminhos internos, exige o jogo fechado e preserva os dados anteriores em uma pasta de segurança." Style="{StaticResource Hint}" FontSize="11" Margin="0,12,0,0"/>
         </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
         <StackPanel>
          <Grid Margin="0,0,0,8">
           <TextBlock Text="JOGAR COM MODS (PERFIL ISOLADO)" FontWeight="Bold" Foreground="#FBBF24" FontSize="12" VerticalAlignment="Center"/>
           <Border Background="#2A1D0B" BorderBrush="#7A5316" BorderThickness="1" CornerRadius="4" Padding="7,2" HorizontalAlignment="Right">
            <TextBlock Text="userdata-mods" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"/>
           </Border>
          </Grid>
          <TextBlock Text="Selecione uma cópia da pasta game onde você aplicou modificações. O jogo iniciará com seus mods gravando o progresso separado em userdata-mods." Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,12"/>
          <Grid Margin="0,0,0,12">
           <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
           <TextBox x:Name="ModsPath" Margin="0,0,12,0"/>
           <Button x:Name="BrowseMods" Grid.Column="1" Content="Escolher pasta…"/>
          </Grid>
          <Button x:Name="PlayModsButton" Content="▶  INICIAR COM MODS" Style="{StaticResource AmberButton}" HorizontalAlignment="Left" Padding="20,11"/>
         </StackPanel>
        </Border>
       </StackPanel>
      </ScrollViewer>

      <!-- ==================== REGISTRO ==================== -->
      <Grid x:Name="PageLogs" Visibility="Collapsed">
       <Grid.RenderTransform><TranslateTransform x:Name="PageLogsTransform" Y="0"/></Grid.RenderTransform>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="REGISTRO DE ATIVIDADE" Style="{StaticResource Heading}"/>
       <TextBlock Text="Acompanhe preparação, verificação de atualizações no GitHub e preparo de shaders." Style="{StaticResource Hint}" Grid.Row="1" Margin="0,0,0,16"/>
       <TextBox x:Name="LogText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12"/>
       <WrapPanel Grid.Row="3" Margin="0,14,0,0">
        <Button x:Name="CopyLogs" Content="Copiar registro" Margin="0,0,10,0"/>
        <Button x:Name="OpenLogs" Content="Abrir logs do jogo"/>
       </WrapPanel>
      </Grid>

      <!-- ==================== CRÉDITOS ==================== -->
      <ScrollViewer x:Name="PageCredits" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
       <ScrollViewer.RenderTransform><TranslateTransform x:Name="PageCreditsTransform" Y="0"/></ScrollViewer.RenderTransform>
       <StackPanel>
        <TextBlock Text="CRÉDITOS E LICENÇAS" Style="{StaticResource Heading}"/>
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" CornerRadius="12" ClipToBounds="True" BorderBrush="#2A3142" BorderThickness="1" Margin="0,0,24,0" VerticalAlignment="Top">
           <Image x:Name="CreditsCover" Stretch="Uniform"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
           <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="MIDNIGHT CLUB L.A. RECOMPILED" FontWeight="ExtraBold" Foreground="#FFFFFF" FontSize="18"/>
            <TextBlock x:Name="CreditsVersion" Text="v1.0.0" FontWeight="Bold" Foreground="#FBBF24" FontSize="16" Margin="10,2,0,0"/>
           </StackPanel>
           <TextBlock Text="Base da recompilação: holdmysocks / RenanQueiroz" Foreground="#E2E8F0" Margin="0,0,0,8"/>
           <TextBlock Text="Runtime e ferramentas: ReXGlue 0.10.0" Foreground="#E2E8F0" Margin="0,0,0,8"/>
           <TextBlock Text="Tecnologia gráfica: AMD FidelityFX (FSR / Frame Generation)" Foreground="#E2E8F0" Margin="0,0,0,8"/>
           <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Repositório oficial: " Foreground="#94A3B8"/>
            <Button x:Name="CreditsGithubButton" Content="https://github.com/shad0w77-code/MC_LA_Recompiled" Style="{StaticResource LinkButton}" FontSize="13" FontWeight="SemiBold"/>
           </StackPanel>
           <TextBlock Text="Projeto comunitário sob licença GPL-3.0-or-later. Midnight Club: Los Angeles e suas marcas pertencem aos respectivos titulares. Nenhuma ISO ou dado proprietário acompanha este pacote." Style="{StaticResource Hint}" FontSize="12"/>
           <Button x:Name="OpenLicenses" Content="Abrir créditos e licenças" HorizontalAlignment="Left" Margin="0,18,0,0"/>
          </StackPanel>
         </Grid>
        </Border>
       </StackPanel>
      </ScrollViewer>
     </Grid>

     <!-- Barra de Status Inferior -->
     <Border Grid.Row="1" Background="#0E1219" BorderBrush="#1F2533" BorderThickness="0,1,0,0" Padding="22,0">
      <Grid VerticalAlignment="Center">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="StatusText" Text="Escolha sua ISO ou localize uma instalação pronta." Foreground="#94A3B8" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       <ProgressBar x:Name="WorkProgress" Grid.Column="1" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="#E5322E" Background="#1E2533" BorderThickness="0" VerticalAlignment="Center"/>
      </Grid>
     </Border>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
